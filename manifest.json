{
  "manifest_version": 3,
  "name": "Feed Destroyer",
  "version": "0.1.0",
  "description": "Hide distracting YouTube and X surfaces while keeping useful pages usable.",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },
  "action": {
    "default_title": "Feed Destroyer",
    "default_popup": "dist/popup.html"
  },
  "icons": {
    "16": "dist/icons/icon-16.png",
    "32": "dist/icons/icon-32.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/icons/icon-48.png"],
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/focus.css"],
      "run_at": "document_start"
    }
  ]
}
